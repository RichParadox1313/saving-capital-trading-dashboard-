# Copy this file to .env and fill in real values for local testing.
# .env is gitignored — it will never be committed or pushed.

# Required — Postgres connection string. Get a free instance at neon.tech
# (takes ~1 min, no credit card). Use the "Pooled connection" string they give you.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Required — your real Anthropic API key. Trading-ideas generation calls
# Claude for real and costs a small amount each time you click Regenerate.
ANTHROPIC_API_KEY=sk-ant-...

# Required — any random string, signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-string

# Required — these log you into BOTH admin.html and the main dashboard
# (as a full Pro user) without needing a real signup/payment.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-local-test-password

# Optional for local testing — payments/email features will just no-op
# without these; only needed if you're testing checkout or signup emails.
APP_URL=http://localhost:8000
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Saving Capital <onboarding@resend.dev>
